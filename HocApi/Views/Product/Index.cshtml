@using HocApi.ViewModels.Product
@* @@model ProductViewModel *@

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<!-- Tích hợp SweetAlert2 để tạo các hộp thoại thông báo đẹp mắt -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* Scoped modern style framework using Plus Jakarta Sans */
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

    :root {
        --primary: #6366f1;
        --primary-hover: #4f46e5;
        --primary-light: #e0e7ff;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --font-sans: 'Plus Jakarta Sans', sans-serif;
    }

    /* Core container wrapper */
    .product-app-container {
        font-family: var(--font-sans);
        color: var(--text-main);
        max-width: 1100px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
    }

    /* Modern header panel */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        padding: 1.5rem 2rem;
        border-radius: 16px;
        box-shadow: 0 4px 20px -2px rgba(148, 163, 184, 0.08);
        border: 1px solid rgba(226, 232, 240, 0.8);
        margin-bottom: 2rem;
    }

    .header-title h2 {
        margin: 0 0 0.35rem 0;
        font-size: 1.65rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .header-title p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    /* Styled buttons */
    .btn-add-product {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: var(--primary);
        color: #ffffff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .btn-add-product:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
    }

    .btn-add-product:active {
        transform: translateY(0);
    }

    /* Product list card */
    .table-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px -10px rgba(148, 163, 184, 0.1);
        overflow: hidden;
    }

    /* Table styling */
    .modern-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .modern-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1.25rem 1.5rem;
        border-bottom: 2px solid var(--border-color);
    }

    .modern-table td {
        padding: 1.25rem 1.5rem;
        font-size: 0.925rem;
        color: #334155;
        border-bottom: 1px solid var(--border-color);
        transition: background-color 0.2s ease;
    }

    .modern-table tr:last-child td {
        border-bottom: none;
    }

    .modern-table tr:hover td {
        background-color: #f8fafc;
    }

    /* Visual badges */
    .badge-id {
        font-family: monospace;
        background-color: #f1f5f9;
        color: #475569;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8rem;
        border: 1px solid #e2e8f0;
    }

    .badge-price {
        font-weight: 700;
        color: #0f172a;
    }

    .badge-qty {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .badge-qty.instock {
        background-color: #ecfdf5;
        color: #065f46;
    }

    .badge-qty.lowstock {
        background-color: #fff7ed;
        color: #9a3412;
    }

    .badge-qty.outofstock {
        background-color: #fef2f2;
        color: #991b1b;
    }

    /* Table actions buttons */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-edit {
        background-color: #eff6ff;
        color: #2563eb;
    }

    .btn-edit:hover {
        background-color: #2563eb;
        color: #ffffff;
    }

    .btn-delete {
        background-color: #fef2f2;
        color: #dc2626;
    }

    .btn-delete:hover {
        background-color: #dc2626;
        color: #ffffff;
    }

    /* Modal Overlay */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(8px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .modal-content {
        background-color: #ffffff;
        width: 100%;
        max-width: 500px;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.8);
        transform: scale(0.9) translateY(20px);
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        overflow: hidden;
    }

    .modal-overlay.active .modal-content {
        transform: scale(1) translateY(0);
    }

    .modal-header {
        padding: 1.25rem 1.75rem;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
    }

    .modal-close:hover {
        color: #0f172a;
    }

    .modal-body {
        padding: 1.75rem;
    }

    /* Modal Form styling */
    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 0.925rem;
        border: 1.5px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-main);
        background-color: #f8fafc;
        transition: all 0.2s ease;
        box-sizing: border-box;
        font-family: var(--font-sans);
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .btn-secondary {
        background-color: #f1f5f9;
        color: #475569;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-secondary:hover {
        background-color: #e2e8f0;
        color: #1e293b;
    }

    .btn-submit {
        background-color: var(--success);
        color: #ffffff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }

    .btn-submit:hover {
        background-color: #059669;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
    }

    /* Empty state card */
    .empty-state {
        padding: 4.5rem 2rem;
        text-align: center;
    }

    .empty-state-icon {
        width: 56px;
        height: 56px;
        background-color: #f1f5f9;
        color: var(--text-muted);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
        transition: transform 0.3s ease;
    }

    .empty-state:hover .empty-state-icon {
        transform: scale(1.08) rotate(5deg);
        color: var(--primary);
        background-color: var(--primary-light);
    }

    .empty-state h3 {
        margin: 0 0 0.35rem 0;
        font-size: 1.1rem;
        color: #334155;
        font-weight: 600;
    }

    .empty-state p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    /* Toast Notification system */
    .toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .toast {
        background-color: #ffffff;
        border-left: 4px solid var(--success);
        color: var(--text-main);
        padding: 0.85rem 1.25rem;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.12);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 280px;
        transform: translateX(120%);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid var(--border-color);
    }

    .toast.show {
        transform: translateX(0);
    }

    .toast-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background-color: #ecfdf5;
        color: var(--success);
        flex-shrink: 0;
    }

    .form-group span[id$="Error"] {
        color: #dc2626; /* Màu đỏ cảnh báo */
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: block;
        font-weight: 500;
    }

    /* CSS cho thanh điều khiển và ô tìm kiếm sản phẩm */
    .controls-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .search-box-wrapper {
        position: relative;
        flex: 1;
        min-width: 280px;
        max-width: 450px;
    }

    .search-input {
        width: 100%;
        padding: 0.75rem 2.5rem 0.75rem 2.75rem; /* Rộng bên trái cho icon kính lúp, rộng bên phải cho nút xóa X */
        font-size: 0.9rem;
        border: 1.5px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-main);
        background-color: #ffffff;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-sizing: border-box;
        font-family: var(--font-sans);
    }

    .search-input:focus {
        outline: none;
        border-color: var(--primary);
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .search-icon-left {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
        display: flex;
        align-items: center;
    }

    .btn-clear-search {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        display: none; /* Mặc định ẩn, chỉ hiển thị khi ô tìm kiếm có chữ */
        align-items: center;
        justify-content: center;
        padding: 4px;
        border-radius: 50%;
        transition: all 0.2s ease;
    }

    .btn-clear-search:hover {
        background-color: #f1f5f9;
        color: var(--danger);
    }
</style>

<div class="product-app-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-title">
            <h2>Danh Sách Sản Phẩm</h2>
        </div>
        <button class="btn-add-product" onclick="openModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Thêm sản phẩm
        </button>
    </div>

    <!-- Controls & Search Bar Section -->
    <div class="controls-bar">
        <div class="search-box-wrapper">
            <!-- Icon kính lúp trang nhã bên trái -->
            <span class="search-icon-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </span>
            
            <!-- Ô nhập từ khóa tìm kiếm -->
            <input type="text" id="searchInput" class="search-input" placeholder="Tìm kiếm sản phẩm theo tên..." autocomplete="off">
            
            <!-- Nút xóa nhanh từ khóa (dấu X) bên phải -->
            <button id="btnClearSearch" class="btn-clear-search" title="Xóa tìm kiếm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!-- Product Table Card -->
    <div class="table-card">
        <table class="modern-table">
            <thead>
                <tr>
                    <th style="width: 15%">Mã sản phẩm</th>
                    <th style="width: 35%">Tên sản phẩm</th>
                    <th style="width: 20%">Đơn giá</th>
                    <th style="width: 18%">Số lượng</th>
                    <th style="width: 12%">Thao tác</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                <!-- Initialized dynamically to avoid hardcoded virtual data -->
            </tbody>
        </table>
    </div>
</div>

<!-- Add/Edit Product Modal Overlay -->
<div class="modal-overlay" id="productModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="modalTitle">Thêm Sản Phẩm Mới</h3>
            <button class="modal-close" onclick="closeModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <form id="productForm" novalidate>
                <!-- Hidden input to store product ID when editing -->
                <input type="hidden" id="productId">

                <div class="form-group">
                    <label for="name">Tên sản phẩm</label>
                    <input type="text" id="name" class="form-control" placeholder="Nhập tên sản phẩm..." required>
                    <span id="nameError"></span>
                </div>

                <div class="form-group">
                    <label for="price">Giá sản phẩm (VNĐ)</label>
                    <input type="number" id="price" min="0" step="any" class="form-control" placeholder="Nhập giá..." required>
                    <span id="priceError"></span>
                </div>


                <div class="form-group">
                    <label for="quantity">Số lượng</label>
                    <input type="number" id="quantity" min="0" class="form-control" placeholder="Nhập số lượng..." required>
                    <span id="quantityError"></span>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-secondary" onclick="closeModal()">Hủy bỏ</button>
                    <button type="submit" class="btn-submit" id="btnSubmit">Lưu sản phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // --- 1. BIẾN TRẠNG THÁI TOÀN CỤC (GLOBAL STATE) ---
    // Mảng này dùng để lưu trữ danh sách sản phẩm được lấy từ cơ sở dữ liệu về phía client (trình duyệt).
    // Giúp ta dễ dàng quản lý, kiểm tra dữ liệu hoặc tìm kiếm mà không cần gọi API liên tục.
    const products = [];

    // Biến lưu trữ bộ đếm thời gian (Timeout ID) cho cơ chế trì hoãn (Debounce) khi tìm kiếm.
    // Giúp giảm tần suất gửi yêu cầu API lên máy chủ khi người dùng đang nhập từ khóa liên tiếp.
    let searchTimeout = null;

    // --- 2. VÒNG ĐỜI TRANG & KHỞI TẠO SỰ KIỆN (LIFECYCLE & EVENTS) ---
    // Sự kiện 'DOMContentLoaded' sẽ kích hoạt ngay khi toàn bộ cấu trúc HTML của trang được tải xong.
    // Đây là nơi an toàn và chuẩn nhất để bắt đầu gọi API lấy dữ liệu và gán các sự kiện lắng nghe (EventListeners).
    document.addEventListener("DOMContentLoaded", function () {
        
        // Tải danh sách sản phẩm từ máy chủ về ngay khi mở trang
        loadProducts();

        // Lắng nghe sự kiện 'input' (khi người dùng bắt đầu gõ chữ vào ô nhập liệu):
        // Khi người dùng đang thấy chữ báo lỗi đỏ, chỉ cần họ gõ phím thay đổi dữ liệu, thông báo lỗi đỏ tương ứng sẽ biến mất ngay lập tức.
        document.getElementById('name').addEventListener('input', () => document.getElementById('nameError').innerText = "");
        document.getElementById('price').addEventListener('input', () => document.getElementById('priceError').innerText = "");
        document.getElementById('quantity').addEventListener('input', () => document.getElementById('quantityError').innerText = "");
        
        // Lắng nghe sự kiện click trên toàn bộ vùng tối bên ngoài Modal (Modal Overlay):
        // Nếu người dùng click vào vùng tối bên ngoài chứ không click vào hộp thoại nhập liệu, Modal sẽ tự động đóng lại.
        document.getElementById('productModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeModal();
            }
        });
        
        // Lắng nghe sự kiện gửi biểu mẫu (submit form):
        // Khi người dùng nhấn nút "Lưu sản phẩm" hoặc "Cập nhật", hàm handleFormSubmit sẽ được gọi để xử lý.
        document.getElementById('productForm').addEventListener('submit', handleFormSubmit);
        
        // --- Đăng ký sự kiện cho thanh Tìm kiếm ---
        const searchInput = document.getElementById('searchInput');
        const btnClearSearch = document.getElementById('btnClearSearch');

        if (searchInput && btnClearSearch) {
            // Lắng nghe sự kiện người dùng gõ phím vào ô nhập liệu tìm kiếm:
            searchInput.addEventListener('input', function () {
                const keyword = this.value;

                // 1. Ẩn/hiện nút xóa nhanh "X" dựa trên trạng thái ô tìm kiếm có dữ liệu hay không
                if (keyword.length > 0) {
                    btnClearSearch.style.display = 'flex';
                } else {
                    btnClearSearch.style.display = 'none';
                }

                // 2. Áp dụng kỹ thuật Debounce:
                // Hủy đợt đếm thời gian cũ nếu người dùng vẫn tiếp tục gõ
                clearTimeout(searchTimeout);
                
                // Kích hoạt bộ đếm giờ mới (chờ 300 mili-giây dừng gõ mới thực sự gọi API tìm kiếm)
                searchTimeout = setTimeout(function () {
                    loadProducts();
                }, 300);
            });

            // Lắng nghe sự kiện khi người dùng click chuột vào nút xóa nhanh "X"
            btnClearSearch.addEventListener('click', function () {
                searchInput.value = ''; // Làm rỗng ô nhập liệu
                this.style.display = 'none'; // Ẩn nút "X" đi
                loadProducts(); // Load lại toàn bộ danh sách sản phẩm
                searchInput.focus(); // Tự động đưa con trỏ chuột tập trung vào ô tìm kiếm để sẵn sàng cho lần gõ tiếp theo
            });
        }
    });

    // --- 3. CÁC TÁC VỤ GỌI API / AJAX ---

    // Hàm loadProducts: Gửi yêu cầu GET lên server để lấy danh sách sản phẩm (có hỗ trợ lọc theo từ khóa tìm kiếm)
    function loadProducts() {
        // Đọc từ khóa tìm kiếm hiện tại từ giao diện (nếu ô tìm kiếm tồn tại)
        const searchInput = document.getElementById('searchInput');
        const keyword = searchInput ? searchInput.value.trim() : '';

        // Tùy biến URL gọi API dựa trên từ khóa tìm kiếm:
        // - Nếu có từ khóa -> Gọi endpoint tìm kiếm '/product/search?keyword=...'
        // - Nếu từ khóa trống -> Gọi endpoint lấy tất cả '/product/list-service-side'
        const url = keyword 
            ? `/product/search?keyword=${encodeURIComponent(keyword)}` 
            : '/product/list-service-side';

        fetch(url, {
            method: 'GET',
        })
        .then(response => response.json()) // Chuyển đổi phản hồi của server từ dạng text thô sang dạng đối tượng JSON
        .then(result => {
            if (result.success) {
                // Đồng bộ dữ liệu mới nhận được từ server vào mảng products của chúng ta:
                products.length = 0; // Xóa sạch dữ liệu cũ trong mảng
                products.push(...result.data); // Thêm toàn bộ danh sách sản phẩm mới vào mảng
                
                // Vẽ lại giao diện bảng sản phẩm từ mảng dữ liệu mới
                updateProductTable();
            } else {
                // Hiển thị thông báo lỗi bằng thư viện SweetAlert2 nếu server báo thất bại
                Swal.fire({
                    title: 'Lỗi',
                    text: 'Lỗi khi lấy dữ liệu: ' + result.message,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => {
            // Khối này chạy nếu xảy ra lỗi kết nối mạng hoặc lỗi server nghiêm trọng (lỗi 500, đứt mạng...)
            console.error('Lỗi AJAX:', error);
            Swal.fire({
                title: 'Lỗi hệ thống',
                text: 'Không thể kết nối đến server để lấy danh sách sản phẩm.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        });
    }

    // Hàm handleFormSubmit: Xử lý logic khi người dùng nhấn nút lưu/cập nhật trên Form
    function handleFormSubmit(e) {
        e.preventDefault(); // Ngăn chặn hành vi mặc định của form (hành vi mặc định là tải lại trang web)
        clearErrors();      // Xóa tất cả các chữ báo lỗi đỏ cũ trước khi kiểm tra điều kiện mới

        // 1. Thu thập dữ liệu từ các ô nhập liệu trong Form (trim() dùng để loại bỏ khoảng trắng thừa ở 2 đầu)
        const idVal = document.getElementById('productId').value;
        const nameVal = document.getElementById('name').value.trim();
        const priceVal = document.getElementById('price').value.trim();
        const quantityVal = document.getElementById('quantity').value.trim();

        // 2. Kiểm tra điều kiện dữ liệu đầu vào (Validation Logic):
        // Nếu phát hiện dữ liệu không hợp lệ, ta hiển thị dòng chữ thông báo lỗi màu đỏ tương ứng và đánh dấu isValid = false.
        let isValid = true;

        // Kiểm tra Tên sản phẩm
        if (nameVal === "") {
            document.getElementById('nameError').innerText = "Tên sản phẩm không được để trống.";
            isValid = false;
        } else if (nameVal.length > 100) {
            document.getElementById('nameError').innerText = "Tên sản phẩm không được vượt quá 100 ký tự.";
            isValid = false;
        }

        // Kiểm tra Giá sản phẩm
        if (priceVal === "") {
            document.getElementById('priceError').innerText = "Giá sản phẩm không được để trống.";
            isValid = false;
        } else if (parseFloat(priceVal) < 1000 || parseFloat(priceVal) > 100000000) {
            document.getElementById('priceError').innerText = "Giá phải từ 1.000đ đến 100.000.000đ.";
            isValid = false;
        }

        // Kiểm tra Số lượng sản phẩm
        if (quantityVal === "") {
            document.getElementById('quantityError').innerText = "Số lượng không được để trống.";
            isValid = false;
        } else if (parseInt(quantityVal) < 1 || parseInt(quantityVal) > 1000) {
            document.getElementById('quantityError').innerText = "Số lượng phải từ 1 đến 1.000 chiếc.";
            isValid = false;
        }

        // Nếu có bất kỳ lỗi nào, ta dừng hàm tại đây (dùng lệnh return) không gửi dữ liệu lên server nữa.
        if (!isValid) return;

        // 3. Chuẩn bị đối tượng dữ liệu sản phẩm để gửi đi
        const productData = {
            name: nameVal,
            price: parseFloat(priceVal),
            quantity: parseInt(quantityVal, 10)
        };

        // Kiểm tra xem đây là hành động Sửa hay Thêm mới:
        // - Nếu input ẩn 'productId' có giá trị -> ta đang ở chế độ Sửa sản phẩm (Edit).
        // - Nếu input ẩn 'productId' trống -> ta đang ở chế độ Thêm mới sản phẩm (Add).
        const isEdit = idVal !== '';
        const url = isEdit ? `/product/update/${idVal}` : '/product/Add';
        const method = isEdit ? 'PUT' : 'POST'; // Dùng PUT cho cập nhật, POST cho thêm mới

        // Nếu là sửa, ta cần gửi kèm thêm ID sản phẩm để server biết cần sửa dòng nào
        if (isEdit) {
            productData.id = parseInt(idVal);
        }

        // 4. Gửi dữ liệu lên Server bằng Fetch API (AJAX)
        fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json' // Báo cho server biết dữ liệu gửi đi ở định dạng JSON
            },
            body: JSON.stringify(productData) // Chuyển đổi đối tượng JS sang chuỗi JSON để truyền qua mạng
        })
        .then(response => {
            if (!response.ok) {
                throw new Error("Lỗi mạng hoặc server trả về lỗi!");
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                // Nếu thành công:
                closeModal(); // Đóng Modal nhập liệu lại
                document.getElementById('productForm').reset(); // Làm trống tất cả các ô nhập liệu trên form
                document.getElementById('productId').value = ''; // Làm trống ID ẩn
                
                // Hiển thị popup thông báo thành công, tự động tắt sau 2 giây
                Swal.fire({
                    title: 'Thành công',
                    text: data.message || (isEdit ? "Cập nhật sản phẩm thành công!" : "Đã thêm sản phẩm thành công!"),
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                });
                
                // Tải lại danh sách sản phẩm mới từ database để hiển thị lên bảng
                loadProducts();
            } else {
                // Nếu server báo thất bại (ví dụ: trùng tên sản phẩm, lỗi logic nghiệp vụ...)
                Swal.fire({
                    title: 'Thất bại',
                    text: data.message || (isEdit ? "Cập nhật sản phẩm thất bại!" : "Thêm sản phẩm thất bại!"),
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => {
            console.error('AJAX Error:', error);
            Swal.fire({
                title: 'Lỗi',
                text: "Không thể kết nối đến server hoặc có lỗi xảy ra!",
                icon: 'error',
                confirmButtonText: 'OK'
            });
        });
    }

    // Hàm deleteProduct: Gửi yêu cầu DELETE để xóa sản phẩm dựa vào ID truyền vào
    function deleteProduct(id) {
        // Hiển thị hộp thoại cảnh báo có nút xác nhận xóa
        Swal.fire({
            title: 'Bạn có chắc chắn muốn xóa sản phẩm này không?',
            text: "Bạn sẽ không thể hoàn tác hành động này!",
            icon: 'warning',
            confirmButtonColor: '#dc2626', // Màu nút Xóa (màu đỏ)
            cancelButtonColor: '#64748b',  // Màu nút Hủy (màu xám)
            showCancelButton: true,
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy',
            reverseButtons: true
        })
        .then(result => {
            // Nếu người dùng nhấn chọn nút 'Xóa' (isConfirmed = true)
            if (result.isConfirmed) {
                fetch(`/product/delete/${id}`, {
                    method: 'DELETE'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            title: 'Thành công',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'OK'
                        });
                        // Load lại danh sách sản phẩm sau khi xóa thành công
                        loadProducts();
                    } else {
                        Swal.fire({
                            title: 'Thất bại',
                            text: data.message,
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        title: 'Lỗi hệ thống',
                        text: 'Đã có lỗi xảy ra vui lòng thử lại sau',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
            }
        });
    }

    // --- 4. CÁC HÀM ĐIỀU KHIỂN CỬA SỔ NHẬP LIỆU (MODAL CONTROLS) ---

    // Hàm openModal: Mở hộp thoại nhập liệu. Nhận vào tham số 'id'.
    // - Nếu id là null -> Người dùng đang nhấn nút "Thêm sản phẩm".
    // - Nếu id khác null -> Người dùng đang nhấn nút Sửa sản phẩm có ID cụ thể.
    function openModal(id = null) {
        const modal = document.getElementById('productModal');
        const form = document.getElementById('productForm');
        
        form.reset(); // Đưa tất cả các ô nhập liệu về trạng thái trống ban đầu
        document.getElementById('productId').value = ''; // Đảm bảo ID ẩn được làm trống
        clearErrors(); // Xóa sạch các dòng thông báo lỗi đỏ cũ nếu có

        if (id === null) {
            // Cài đặt nội dung tiêu đề và nút bấm cho chế độ THÊM MỚI
            document.getElementById('modalTitle').innerText = "Thêm Sản Phẩm Mới";
            document.getElementById('btnSubmit').innerText = "Lưu sản phẩm";
            document.getElementById('btnSubmit').style.backgroundColor = "var(--success)"; // Màu xanh lục
            
            modal.classList.add('active'); // Thêm class 'active' để kích hoạt CSS hiển thị Modal
            document.getElementById('name').focus(); // Tự động trỏ con nháy chuột vào ô nhập tên đầu tiên
        } else {
            // Cài đặt nội dung tiêu đề và nút bấm cho chế độ CẬP NHẬT (SỬA)
            document.getElementById('modalTitle').innerText = "Cập Nhật Sản Phẩm";
            document.getElementById('btnSubmit').innerText = "Cập nhật";
            document.getElementById('btnSubmit').style.backgroundColor = "var(--primary)"; // Màu xanh dương
            
            // Gọi API lên máy chủ lấy chi tiết sản phẩm theo ID để hiển thị thông tin cũ lên form
            fetch(`/product/get-by-id/${id}`)
                .then(res => res.json())
                .then(result => {
                    if (result.success && result.data) {
                        const product = result.data;
                        // Điền các thông tin cũ của sản phẩm vào các ô input tương ứng trên Form
                        document.getElementById('productId').value = product.id;
                        document.getElementById('name').value = product.name;
                        document.getElementById('price').value = product.price;
                        document.getElementById('quantity').value = product.quantity;
                        
                        modal.classList.add('active'); // Hiển thị modal lên màn hình sau khi đã load xong dữ liệu
                        document.getElementById('name').focus();
                    } else {
                        Swal.fire({
                            title: 'Lỗi',
                            text: result.message || 'Không thể lấy thông tin sản phẩm',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                })
                .catch(err => {
                    console.error(err);
                    Swal.fire({
                        title: 'Lỗi hệ thống',
                        text: 'Không lấy được thông tin từ máy chủ.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
        }
    }

    // Hàm closeModal: Đóng cửa sổ nhập liệu
    function closeModal() {
        const modal = document.getElementById('productModal');
        modal.classList.remove('active'); // Loại bỏ class 'active' trong CSS để ẩn modal đi
        clearErrors(); // Xóa sạch các thông báo lỗi đỏ
    }

    // Hàm editProduct: Hàm cầu nối khi click nút Sửa ở mỗi dòng trong bảng
    function editProduct(id) {
        openModal(id);
    }

    // --- 5. CÁC HÀM VẼ GIAO DIỆN (RENDER FUNCTIONS) ---

    // Hàm updateProductTable: Vẽ lại danh sách sản phẩm lên bảng HTML dựa vào dữ liệu trong mảng 'products'
    function updateProductTable() {
        const tbody = document.getElementById('productTableBody');
        
        // Trường hợp 1: Mảng products rỗng (chưa có sản phẩm nào hoặc tìm kiếm không khớp kết quả nào)
        // Kiểm tra xem người dùng có đang thực hiện tìm kiếm hay không để hiển thị thông báo phù hợp
        if (products.length === 0) {
            const searchInput = document.getElementById('searchInput');
            const isSearching = searchInput && searchInput.value.trim() !== '';

            tbody.innerHTML = `
                <tr>
                    <td colspan="5">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    ${isSearching 
                                        ? `<circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>`
                                        : `<circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>`
                                    }
                                </svg>
                            </div>
                            <h3>${isSearching ? 'Không tìm thấy sản phẩm nào phù hợp' : 'Chưa có sản phẩm nào'}</h3>
                            <p>${isSearching 
                                ? 'Vui lòng thử lại bằng một từ khóa tìm kiếm khác.' 
                                : 'Nhấp vào nút <strong>"Thêm sản phẩm"</strong> để thêm sản phẩm mới của bạn.'}
                            </p>
                        </div>
                    </td>
                </tr>
            `;
            return;
        }

        // Trường hợp 2: Có dữ liệu sản phẩm trong mảng
        // Duyệt qua từng sản phẩm trong mảng bằng hàm map() và tạo ra một chuỗi HTML chứa cấu trúc dòng tr tương ứng
        tbody.innerHTML = products.map((product) => {
            // Định dạng hiển thị giá tiền sang tiền tệ Việt Nam (ví dụ: 10000 -> 10.000 ₫)
            const formattedPrice = new Intl.NumberFormat('vi-VN', { 
                style: 'currency', 
                currency: 'VND' 
            }).format(product.price);

            // Kiểm tra số lượng tồn kho để hiển thị nhãn trạng thái (Badge) tương ứng:
            // - Số lượng <= 0: Hết hàng (Nhãn màu đỏ)
            // - Số lượng < 5: Sắp hết hàng (Nhãn màu vàng/cam)
            // - Số lượng >= 5: Còn hàng (Nhãn màu xanh lục)
            let qtyBadgeClass = 'instock';
            let qtyText = `Còn hàng (${product.quantity})`;

            if (product.quantity <= 0) {
                qtyBadgeClass = 'outofstock';
                qtyText = 'Hết hàng';
            } else if (product.quantity < 5) {
                qtyBadgeClass = 'lowstock';
                qtyText = `Sắp hết (${product.quantity})`;
            }

            // Trả về chuỗi HTML định nghĩa một dòng của bảng sản phẩm
            // Sử dụng hàm escapeHtml(product.name) để lọc sạch dữ liệu Tên sản phẩm trước khi chèn vào trang
            return `
                <tr id="product-row-${product.id}">
                    <td><span class="badge-id">SP-${String(product.id).padStart(4, '0')}</span></td>
                    <td style="font-weight: 600; color: #0f172a;">${escapeHtml(product.name)}</td>
                    <td><span class="badge-price">${formattedPrice}</span></td>
                    <td><span class="badge-qty ${qtyBadgeClass}">${qtyText}</span></td>
                    <td>
                        <div class="action-buttons">
                            <!-- Nút sửa sản phẩm: click sẽ gọi hàm editProduct truyền vào ID sản phẩm đó -->
                            <button class="btn-action btn-edit" title="Sửa sản phẩm" onclick="editProduct(${product.id})">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                            <!-- Nút xóa sản phẩm: click sẽ gọi hàm deleteProduct truyền vào ID sản phẩm đó -->
                            <button class="btn-action btn-delete" title="Xóa sản phẩm" onclick="deleteProduct(${product.id})">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }).join(''); // Nối tất cả các chuỗi HTML của từng dòng lại thành một chuỗi duy nhất để chèn vào thẻ tbody
    }

    // --- 6. CÁC HÀM TIỆN ÍCH BỔ TRỢ (HELPERS & UTILITIES) ---

    // Hàm clearErrors: Xóa sạch các thông báo lỗi màu đỏ hiển thị trên giao diện Form
    function clearErrors() {
        document.getElementById('nameError').innerText = "";
        document.getElementById('priceError').innerText = "";
        document.getElementById('quantityError').innerText = "";
    }

    // Hàm escapeHtml: Mã hóa các ký tự đặc biệt trong chuỗi (ví dụ: < thành &lt;, > thành &gt;...)
    // Đây là kỹ thuật bảo mật bắt buộc để chống lỗi hiển thị và ngăn chặn tấn công XSS (mã độc dạng script do người dùng cố tình nhập).
    function escapeHtml(str) {
        if (!str) return '';
        return str.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>
